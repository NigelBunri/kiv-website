# Public site
NEXT_PUBLIC_SITE_URL=https://kingdomimpactventures.org

# KIS availability controls
NEXT_PUBLIC_KIS_LAUNCH_LIST=true
NEXT_PUBLIC_KIS_ANDROID_AVAILABLE=false
NEXT_PUBLIC_KIS_IOS_AVAILABLE=false
NEXT_PUBLIC_KIS_GOOGLE_PLAY_URL=
NEXT_PUBLIC_KIS_APP_STORE_URL=
NEXT_PUBLIC_KIS_WEB_APP_URL=

# Django backend base URL, used server-side only by app/api/payment-status
# and app/api/receipts (both server-side proxy routes). The backend runs on
# AWS Lightsail (Docker/GHCR) — leave blank to use the deployed default
# (api.kingdomimpactventures.org). No NEXT_PUBLIC_ prefix — this is never
# sent to the browser.
KIS_API_BASE_URL=

# Cloudflare Turnstile — CAPTCHA on every public form. Site key ships to the
# browser (safe); secret key stays server-only, used to verify the token on
# submit. Leave both blank in local dev to render forms without the widget.
# See docs/forms-integration-setup.md for how to obtain these.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only form/email provider values. Do not expose these with NEXT_PUBLIC_.
KIV_FORM_PROVIDER=
KIV_FORM_TO_EMAIL=
KIV_FORM_FROM_EMAIL=
# KIV_FORM_WEBHOOK_URL/SECRET: a Google Apps Script Web App URL that appends
# each validated submission as a row to a Google Sheet. See
# docs/forms-integration-setup.md for the exact Apps Script + deployment steps.
KIV_FORM_WEBHOOK_URL=
KIV_FORM_WEBHOOK_SECRET=
AWS_REGION=
AWS_SES_CONFIGURATION_SET=

# Optional operations
KIV_ANALYTICS_PROVIDER=
KIV_ERROR_MONITORING_DSN=

# Form submission rate limiting. Leave blank to use an in-memory counter,
# which is correct as long as this site runs a single replica (see
# docs/deployment.md). Set REDIS_URL once you run more than one replica
# behind a load balancer, so the limit is shared instead of per-replica.
REDIS_URL=
