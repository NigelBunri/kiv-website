{
  "name": "kiv-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "pnpm run typecheck && pnpm run smoke && pnpm run build",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .open-next",
    "typecheck": "tsc --noEmit",
    "smoke": "node --test tests/site-smoke.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "ioredis": "^5.11.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.8.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.115.0"
  },
  "type": "module",
  "description": "Production-ready public website for Kingdom Impact Ventures.",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.24",
      "next>sharp": "0.35.2",
      "postcss": "8.5.24",
      "sharp": "0.35.2",
      "brace-expansion@2": "^2.1.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
